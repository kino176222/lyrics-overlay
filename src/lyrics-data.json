{
  "lyrics": [
    {
      "text": "色が褪せた朝焼けに",
      "startTime": 7.17542,
      "endTime": 12.597836,
      "isSet": true
    },
    {
      "text": "燻る昨日の残響",
      "startTime": 12.697835999999999,
      "endTime": 18.287199,
      "isSet": true
    },
    {
      "text": "交わした言葉の重さが",
      "startTime": 18.387199000000003,
      "endTime": 23.027918,
      "isSet": true
    },
    {
      "text": "鎖みたいに絡みつく",
      "startTime": 23.127918,
      "endTime": 28.778582,
      "isSet": true
    },
    {
      "text": "痛みで心 焼き尽くして",
      "startTime": 28.878582,
      "endTime": 34.085534,
      "isSet": true
    },
    {
      "text": "黒い衝動を翼に変えて",
      "startTime": 34.185534000000004,
      "endTime": 43.321296,
      "isSet": true
    },
    {
      "text": "走り出す 灰燼の空の下",
      "startTime": 43.421296,
      "endTime": 48.613998,
      "isSet": true
    },
    {
      "text": "答えなんてまだ見えないまま",
      "startTime": 48.713998000000004,
      "endTime": 54.017108,
      "isSet": true
    },
    {
      "text": "凍てついた鏡に映る 完璧な絶望さえ",
      "startTime": 54.117108,
      "endTime": 59.359482,
      "isSet": true
    },
    {
      "text": "超えていけ 傷だらけの鼓動で",
      "startTime": 59.459482,
      "endTime": 64.84797,
      "isSet": true
    },
    {
      "text": "夜明けの轍を刻むから",
      "startTime": 64.94797,
      "endTime": 70.36759,
      "isSet": true
    },
    {
      "text": "削れたスパイクの跡",
      "startTime": 70.46759,
      "endTime": 75.323874,
      "isSet": true
    },
    {
      "text": "正しいフォームの残像",
      "startTime": 75.423874,
      "endTime": 80.835191,
      "isSet": true
    },
    {
      "text": "叩きつけるだけの拳じゃ",
      "startTime": 80.93519099999999,
      "endTime": 85.952933,
      "isSet": true
    },
    {
      "text": "何もかもが遠すぎて",
      "startTime": 86.052933,
      "endTime": 91.082616,
      "isSet": true
    },
    {
      "text": "苛立ちで視野 滲んでく",
      "startTime": 91.182616,
      "endTime": 96.430172,
      "isSet": true
    },
    {
      "text": "それでも脚を止められない",
      "startTime": 96.530172,
      "endTime": 104.270445,
      "isSet": true
    },
    {
      "text": "駆け抜ける 灰燼の空の下",
      "startTime": 104.37044499999999,
      "endTime": 108.750173,
      "isSet": true
    },
    {
      "text": "千切れそうな心 抱えたまま",
      "startTime": 108.850173,
      "endTime": 114.020059,
      "isSet": true
    },
    {
      "text": "揺るぎない王者の瞳が 私の弱さ嘲笑う",
      "startTime": 114.120059,
      "endTime": 119.367782,
      "isSet": true
    },
    {
      "text": "振り払え 有りっ丈の怒りで",
      "startTime": 119.467782,
      "endTime": 124.743844,
      "isSet": true
    },
    {
      "text": "微かな光を探すから",
      "startTime": 124.84384399999999,
      "endTime": 130.623049,
      "isSet": true
    },
    {
      "text": "「強くなれ」と聞こえた気がした",
      "startTime": 130.723049,
      "endTime": 135.073822,
      "isSet": true
    },
    {
      "text": "それは呪いか それとも祈りか",
      "startTime": 135.173822,
      "endTime": 140.456757,
      "isSet": true
    },
    {
      "text": "この空の向こう側で",
      "startTime": 140.556757,
      "endTime": 146.199919,
      "isSet": true
    },
    {
      "text": "本当は 何を望むの",
      "startTime": 146.299919,
      "endTime": 151.8681,
      "isSet": true
    },
    {
      "text": "走り出す 灰燼の空の下",
      "startTime": 151.9681,
      "endTime": 156.865144,
      "isSet": true
    },
    {
      "text": "答えなんていらないのかもしれない",
      "startTime": 156.96514399999998,
      "endTime": 162.276746,
      "isSet": true
    },
    {
      "text": "凍てついた鏡をいつか この手で打ち砕いて",
      "startTime": 162.376746,
      "endTime": 167.459838,
      "isSet": true
    },
    {
      "text": "超えていけ 傷だらけの鼓動で",
      "startTime": 167.55983799999998,
      "endTime": 172.839283,
      "isSet": true
    },
    {
      "text": "夜明けの轍を刻むから",
      "startTime": 172.939283,
      "endTime": 178.714032,
      "isSet": true
    },
    {
      "text": "灰に塗れても",
      "startTime": 178.814032,
      "endTime": 183.715353,
      "isSet": true
    },
    {
      "text": "この脚が燃え尽きても",
      "startTime": 183.815353,
      "endTime": 188.661951,
      "isSet": true
    },
    {
      "text": "明日へ",
      "startTime": 188.76195099999998,
      "endTime": 193.502531,
      "isSet": true
    }
  ],
